# Server Configuration
NODE_ENV=development
PORT=3000

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/maris

# JWT Configuration
JWT_SECRET=super_secret_jwt_sign_key_change_in_production
JWT_EXPIRES_IN=1d

# Logging Configuration
LOG_LEVEL=info

# External Integrations Configuration
# OpenWeatherMap — https://openweathermap.org/api
OPENWEATHER_API_KEY=435ef355f38a4c9318fc1605ac0fe227

# IMD — Register at https://api.imd.gov.in to obtain an API key
# IMD_API_KEY=your_imd_api_key_here
# ENABLE_LIVE_IMD=false

# INCOIS ERDDAP — No key required for public datasets
# ENABLE_LIVE_INCOIS=false

# Copernicus Marine Service — Register at https://marine.copernicus.eu
# COPERNICUS_USERNAME=your_copernicus_username
# COPERNICUS_PASSWORD=your_copernicus_password
# ENABLE_LIVE_COPERNICUS=false

# WDPA (Protected Planet) — Register at https://api.protectedplanet.net
# WDPA_API_KEY=your_wdpa_api_key_here
# ENABLE_LIVE_GEOSPATIAL=false

# Storage Configuration
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=maris-evidence
MINIO_USE_SSL=false
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=50

